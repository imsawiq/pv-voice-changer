{
  "schemaVersion": 1,
  "id": "pv-voice-changer",
  "version": "${version}",
  "name": "Plasmo Voice Changer",
  "description": "Voice changer for Plasmo Voice: presets, custom tuning, saved profiles, self listen, a native settings UI, an API for other mods, and server-side policy with commands and shared voices.",
  "authors": [
    "sawiq_"
  ],
  "contact": {
    "sources": "https://github.com/imsawiq/pv-voice-changer",
    "issues": "https://github.com/imsawiq/pv-voice-changer/issues",
    "discord": "https://discord.gg/UTxEy4PtSU"
  },
  "license": "CC-BY-NC-SA-4.0",
  "icon": "assets/pv-voice-changer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.sawiq.PvVoiceChanger"
    ],
    "client": [
      "org.sawiq.client.PvVoiceChangerClient"
    ]
  },
  "mixins": [
    "pv-voice-changer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.1 <=26.1.2",
    "plasmovoice": ">=2.1.8"
  }
}
